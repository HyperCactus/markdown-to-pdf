#!/usr/bin/env bash

set -euo pipefail

readonly PROGRAM_NAME="ipynb2pdf"
readonly PROGRAM_VERSION="0.1.0"
readonly MIN_PANDOC_VERSION="3.8"

print_help() {
    cat <<'EOF'
Usage: ipynb2pdf [OPTIONS] INPUT.ipynb

Convert a Jupyter notebook to a syntax-highlighted PDF with Pandoc and XeLaTeX.

Markdown, LaTeX math, code cells, and saved cell outputs (including figures)
are included. Run the notebook first if you want its latest outputs in the PDF.

Options:
  -o, --output FILE  Write the PDF to FILE (default: beside INPUT.ipynb)
  -h, --help         Show this help and exit
  -V, --version      Show version information and exit

Examples:
  ipynb2pdf analysis.ipynb
  ipynb2pdf analysis.ipynb -o report.pdf
  ipynb2pdf -o report.pdf "My Project/analysis.ipynb"
EOF
}

die() {
    printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

show_progress() {
    local percent="$1"
    local label="$2"
    local width=24
    local filled=$((percent * width / 100))
    local empty=$((width - filled))
    local bar spaces
    printf -v bar '%*s' "$filled" ''
    printf -v spaces '%*s' "$empty" ''
    bar="${bar// /#}${spaces}"

    if [[ -t 1 ]]; then
        printf '\r[%s] %3d%%  %-18s' "$bar" "$percent" "$label"
    else
        printf '[%3d%%] %s\n' "$percent" "$label"
    fi
}

conversion_failed() {
    local stage="$1"
    local details="$2"
    [[ -t 1 ]] && printf '\n' >&2
    printf '%s: error: %s failed\n' "$PROGRAM_NAME" "$stage" >&2
    tail -n 20 "$details" >&2
    exit 1
}

INPUT=""
OUTPUT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output)
            [[ $# -ge 2 ]] || die "option '$1' requires a file path"
            [[ -n "$2" ]] || die "output path cannot be empty"
            OUTPUT="$2"
            shift 2
            ;;
        --output=*)
            OUTPUT="${1#*=}"
            [[ -n "$OUTPUT" ]] || die "output path cannot be empty"
            shift
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        -V|--version)
            printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION"
            exit 0
            ;;
        --)
            shift
            [[ $# -gt 0 ]] || die "missing input file"
            [[ -z "$INPUT" ]] || die "only one input file is supported"
            INPUT="$1"
            shift
            [[ $# -eq 0 ]] || die "only one input file is supported"
            ;;
        -*)
            die "unknown option '$1' (try --help)"
            ;;
        *)
            [[ -z "$INPUT" ]] || die "only one input file is supported"
            INPUT="$1"
            shift
            ;;
    esac
done

[[ -n "$INPUT" ]] || {
    print_help >&2
    exit 1
}

[[ -f "$INPUT" ]] || die "input file not found: $INPUT"
[[ "${INPUT,,}" == *.ipynb ]] || die "input file must have an .ipynb extension: $INPUT"
INPUT="$(realpath "$INPUT")"

INPUT_DIR="$(dirname "$INPUT")"
INPUT_NAME="$(basename "$INPUT")"
INPUT_STEM="${INPUT_NAME%.*}"

if [[ -z "$OUTPUT" ]]; then
    OUTPUT="$INPUT_DIR/$INPUT_STEM.pdf"
else
    OUTPUT="$(realpath -m "$OUTPUT")"
fi

[[ "$OUTPUT" != "$INPUT" ]] || die "input and output paths must be different"
[[ ! -d "$OUTPUT" ]] || die "output path is a directory: $OUTPUT"
mkdir -p "$(dirname "$OUTPUT")"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
HEADER="$SCRIPT_DIR/pdf-header.tex"
FILTER="$SCRIPT_DIR/minted.lua"

[[ -f "$HEADER" ]] || die "support file not found: $HEADER"
[[ -f "$FILTER" ]] || die "support file not found: $FILTER"

for cmd in pandoc xelatex latexmk pygmentize kpsewhich; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command '$cmd' was not found on PATH"
done

PANDOC_VERSION="$(pandoc --version | awk 'NR == 1 { print $2; exit }')"
if [[ -z "$PANDOC_VERSION" ]] ||
    ! printf '%s\n%s\n' "$MIN_PANDOC_VERSION" "$PANDOC_VERSION" | sort -V -C; then
    die "Pandoc >= $MIN_PANDOC_VERSION is required (found ${PANDOC_VERSION:-unknown})"
fi

kpsewhich minted.sty >/dev/null 2>&1 || die "LaTeX package 'minted' is not installed"

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

TEX="$TMPDIR/document.tex"
PDF="$TMPDIR/document.pdf"
LOG="$TMPDIR/document.log"
MEDIA_DIR="$TMPDIR/media"
PANDOC_LOG="$TMPDIR/pandoc.log"
BUILD_LOG="$TMPDIR/build.log"

show_progress 10 "Reading notebook"

if ! pandoc "$INPUT" \
    --standalone \
    --from=ipynb+raw_tex \
    --to=latex \
    --extract-media="$MEDIA_DIR" \
    --syntax-highlighting=none \
    --lua-filter="$FILTER" \
    --include-in-header="$HEADER" \
    --resource-path="$INPUT_DIR" \
    -V papersize=a4 \
    -V geometry:margin=25mm \
    -V monofont="DejaVu Sans Mono" \
    -o "$TEX" >"$PANDOC_LOG" 2>&1; then
    conversion_failed "notebook preparation" "$PANDOC_LOG"
fi

show_progress 45 "Typesetting PDF"

if ! (
    cd "$TMPDIR"
    export TEXINPUTS=".:$INPUT_DIR//:${TEXINPUTS:-}"
    latexmk \
        -gg \
        -xelatex \
        -shell-escape \
        -interaction=nonstopmode \
        -halt-on-error \
        document.tex
) >"$BUILD_LOG" 2>&1; then
    conversion_failed "PDF typesetting" "$BUILD_LOG"
fi

show_progress 90 "Checking output"

if grep -q 'Overfull \\hbox' "$LOG"; then
    [[ -t 1 ]] && printf '\n' >&2
    printf '%s: error: content overflow detected:\n' "$PROGRAM_NAME" >&2
    grep 'Overfull \\hbox' "$LOG" >&2
    exit 1
fi

if grep -q 'Missing character:' "$LOG"; then
    [[ -t 1 ]] && printf '\n' >&2
    printf '%s: error: missing font characters detected:\n' "$PROGRAM_NAME" >&2
    grep 'Missing character:' "$LOG" >&2
    exit 1
fi

install -m 0644 "$PDF" "$OUTPUT"
show_progress 100 "Complete"
[[ -t 1 ]] && printf '\n'
printf '%s generated\n' "$OUTPUT"
